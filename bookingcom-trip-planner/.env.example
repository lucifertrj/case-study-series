# Smart Filter PoC — Environment Variables
# Copy to .env and fill in your keys

# Required: OpenAI API key for intent parsing + embeddings
OPENAI_API_KEY=sk-...your-key-here...
LLM_API_KEY=sk-...your-key-here...

# Qdrant for the filter on the property data
QDRANT_API_KEY=ey....your-key-here...
QDRANT_ENDPOINT=https://...your-endpoint..

